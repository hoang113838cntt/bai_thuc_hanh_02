#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, m;
    float **a;
    printf("Nhap so hang: ");
    scanf("%d", &n);
    printf("Nhap so cot: ");
    scanf("%d", &m);
    a = (float**)malloc(n * sizeof(float*));
    for (int i = 0; i < n; i++) {
        a[i] = (float*)malloc(m * sizeof(float));
    }
    printf("Nhap mang:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            scanf("%f", (*(a + i) + j));
        }
    }
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            printf("%.2f ", *(*(a + i) + j));
        }
        printf("\n");
    }
    for (int i = 0; i < n; i++) {
        free(a[i]);
    }
    free(a);
    return 0;
}
