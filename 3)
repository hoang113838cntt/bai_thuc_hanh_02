#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct SinhVien {
    char HoTen[100];
    int MSV;
    float d1, d2, d3;
};

int main() {
    int n;
    struct SinhVien *sv;
    printf("Nhap so luong sinh vien: ");
    scanf("%d", &n);
    getchar();
    sv = (struct SinhVien*)malloc(n * sizeof(struct SinhVien));
    for (int i = 0; i < n; i++) {
        printf("Nhap sinh vien thu %d\n", i + 1);
        printf("Nhap ho ten sinh vien: ");
        fgets((sv + i)->HoTen, 100, stdin);
        (sv + i)->HoTen[strcspn((sv + i)->HoTen, "\n")] = '\0';
        printf("Nhap ma sinh vien: ");
        scanf("%d", &(sv + i)->MSV);
        printf("Nhap diem 1: ");
        scanf("%f", &(sv + i)->d1);
        printf("Nhap diem 2: ");
        scanf("%f", &(sv + i)->d2);
        printf("Nhap diem 3: ");
        scanf("%f", &(sv + i)->d3);
        getchar();
    }
    for (int i = 0; i < n; i++) {
        printf("Thong tin sinh vien thu %d\n", i + 1);
        printf("Ho ten sinh vien: ");
        printf("%s\n", (sv + i)->HoTen);
        printf("Ma sinh vien: ");
        printf("%d\n", (sv + i)->MSV);
        printf("Diem 1: ");
        printf("%.2f\n", (sv + i)->d1);
        printf("Diem 2: ");
        printf("%.2f\n", (sv + i)->d2);
        printf("Diem 3: ");
        printf("%.2f\n", (sv + i)->d3);
    }
    free(sv);
    return 0;
}
